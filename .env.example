# GEMINI_API_KEY: Required if Gemini API routes are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet or published Netlify site is hosted.
APP_URL="https://zpwebsite.netlify.app"

# ============================================================================
# SERVER-ONLY ENVIRONMENT VARIABLES FOR OWNER RSVP DASHBOARD (NEVER PREFIX WITH VITE_)
# Configure these in Netlify Site Settings -> Environment variables.
# ============================================================================

# Comma-separated list of authorized Google owner email(s) allowed to view RSVP data.
OWNER_ALLOWED_EMAILS="PuteraFaizal26@gmail.com"

# Firebase Project ID used to cryptographically verify Google/Firebase ID tokens.
FIREBASE_PROJECT_ID="gen-lang-client-0205371002"

# Private Google Sheet ID linked to the wedding RSVP Google Form (the ID in the Sheet URL).
GOOGLE_SHEET_ID=""

# Optional sheet tab/range override (defaults automatically to the first worksheet tab, columns A:Z).
GOOGLE_SHEET_RANGE=""

# Google Cloud Service Account credentials (granted Viewer access on the private Google Sheet).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
